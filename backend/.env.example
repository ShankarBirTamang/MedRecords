# Render injects PORT automatically; locally defaults to 5000.
PORT=5000
# MongoDB Atlas connection string (include the db name after .net/):
# mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/medrecords?appName=Cluster0
MONGO_URI=mongodb://127.0.0.1:27017/medrecords
JWT_SECRET=replace-with-a-long-random-string
